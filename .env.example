# Copy this file to .env for local development (never commit the real .env).
# In production, set these as real environment variables in your host's
# dashboard instead of using a file.

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Never "True" in production.
DEBUG=True

# Comma-separated list, e.g. musicacademy.com,www.musicacademy.com
ALLOWED_HOSTS=

# Comma-separated list with scheme, e.g. https://musicacademy.com,https://www.musicacademy.com
CSRF_TRUSTED_ORIGINS=

# Provided automatically by Render/Railway's managed Postgres add-on.
# Leave unset locally to fall back to SQLite.
DATABASE_URL=
